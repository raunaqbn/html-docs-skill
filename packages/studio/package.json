{
  "name": "@html-docs/studio",
  "version": "0.1.0",
  "type": "module",
  "description": "Evidence-aware educational video Studio for HTML Docs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raunaqbn/html-docs-skill.git",
    "directory": "packages/studio"
  },
  "homepage": "https://www.html-docs.com/showcase",
  "files": [
    "src/",
