    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@html-docs/html-video": "workspace:*",
    "tsx": "^4.22.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "5.7.3"
  }
}
