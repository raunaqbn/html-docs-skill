{
  "name": "@html-docs/html-video",
  "version": "0.4.1",
  "private": false,
  "type": "module",
  "description": "Deterministic HTML composition validation, preview, and video rendering for HTML Docs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raunaqbn/html-docs-skill.git",
    "directory": "packages/html-video"
  },
  "homepage": "https://www.html-docs.com/agents",
  "files": [
    "bin/",
    "fixtures/hello.json",
    "src/",
    "!src/*.test.ts",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "cli": "node --import tsx src/cli.ts"
  },
  "bin": {
    "html-docs-video": "bin/cli.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./renderer": "./src/renderer.ts",
    "./types": "./src/types.ts",
    "./validate": "./src/validate.ts",
    "./audio": "./src/audio.ts",
    "./course": "./src/course.ts"
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/supabase-js": "^2.84.0",
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.1.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.22.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pngjs": "^6.0.5",
    "typescript": "5.7.3"
  }
}
